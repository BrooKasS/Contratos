generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

  
}

model Contrato {
  id              String   @id @default(uuid())
  numeroContrato  String   @unique
  proveedor       String
  tipoContrato    String?
  fechaInforme    DateTime?
  generalidades   Json
  principal       Json
  crp             Json 
  polizas         Json
  otrosies        Json
  pagos           Json

  createdAt       DateTime @default(now())
}
