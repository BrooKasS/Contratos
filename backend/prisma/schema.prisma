// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contrato {
  id              String   @id @default(uuid())
  numeroContrato  String   @unique
  proveedor       String
  tipoContrato    String?
  fechaInforme    DateTime?
  
  generalidades   Json
  principal       Json
  crp             Json
  polizas         Json
  otrosies        Json
  pagos           Json
   //campos nuevos para sección segui
  abogadoResponsable  String?
  estadoContrato      String?  
  sistema             String?
  novedad             String?   @db.Text
  
 
  fechaNovedad        DateTime?
  
  alerta20Enviada Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  

}